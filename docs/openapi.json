                "schema": {
                  "$ref": "#/components/schemas/CoursePage"
                }
              }
            }
          },
          "401": {
            "description": "Token assente, malformato, inesistente, revocato o scaduto (stesso corpo in ogni caso).",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Credenziali non valide o mancanti."
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
