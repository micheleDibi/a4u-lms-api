              "application/json": {
                "example": {
                  "detail": "Troppe richieste."
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Secondi interi (≥ 1) da attendere prima di riprovare.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Errore inatteso (dettagli solo nel log del servizio).",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Errore interno."
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "404": {
            "description": "Organizzazione non associata alla chiave, eliminata o inesistente, oppure corso inesistente o di un'altra organizzazione. Non distingue «non esiste» da «non accessibile».",
            "content": {
