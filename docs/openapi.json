{
  "openapi": "3.1.0",
  "info": {
    "title": "a4u-lms-api",
    "description": "API HTTP di **sola lettura** che espone a un LMS i corsi generati da a4u: organizzazioni, corsi, moduli, lezioni, URL pubblici dei file e test di verifica.\n\n- **Autenticazione:** header `Authorization: Bearer <token>` su tutti gli endpoint `/v1`.\n- **Errori:** corpo `{\"detail\": \"...\"}`; 404 uniforme per risorse inesistenti o non accessibili (mai 403).\n- **Metodi:** solo GET; gli altri metodi rispondono 405 `Metodo non consentito.` con header `Allow`.\n- **Limiti:** richieste al minuto per chiave; oltre il limite 429 con `Retry-After`.\n- **Date:** ISO 8601 con fuso orario; la parte frazionaria dei secondi è facoltativa (assente se zero): usare un parser ISO 8601.\n",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://lms-api.ersaf.it",
      "description": "Produzione"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Il servizio è attivo",
        "description": "Nessuna autenticazione e nessun accesso al DB. Pensato per i controlli interni.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Il servizio è pronto",
        "description": "Verifica la connessione al DB e il contratto delle colonne lette. Nessuna autenticazione. Pensato per i controlli interni.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "Servizio non pronto (dettagli solo nel log).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                },
                "example": {
                  "status": "unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations": {
      "get": {
        "summary": "Elenco delle organizzazioni",
        "description": "Organizzazioni associate alla chiave API e non eliminate, ordinate per nome e id. `courses_count` conta i corsi in ogni stato.",
        "operationId": "get_organizations_v1_organizations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrganizationOut"
                  },
                  "type": "array",
                  "title": "Response Get Organizations V1 Organizations Get"
                }
              }
            }
          },
          "401": {
            "description": "Token assente, malformato, inesistente, revocato o scaduto (stesso corpo in ogni caso).",
            "headers": {
              "WWW-Authenticate": {
                "description": "Sempre `Bearer`.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "Credenziali non valide o mancanti."
                }
              }
            }
          },
          "429": {
            "description": "Limite di richieste al minuto superato per la chiave.",
            "headers": {
              "Retry-After": {
                "description": "Secondi interi (≥ 1) da attendere prima di riprovare.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "Troppe richieste."
                }
              }
            }
          },
          "500": {
            "description": "Errore inatteso (dettagli solo nel log del servizio).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                },
                "example": {
                  "detail": "Errore interno."
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/organizations/{org_id}/courses": {
      "get": {
        "summary": "Elenco paginato dei corsi di un'organizzazione",
        "description": "Corsi dell'organizzazione in ogni stato, ordinati per `updated_at` decrescente e poi per `id`. Per la sincronizzazione incrementale usare `updated_since`: restituisce i corsi con `updated_at`, `last_generated_at` o `last_assessment_at` maggiore o uguale alla data indicata.\n\nIn caso di parametri non validi (per esempio `updated_since` senza fuso orario o `limit` > 100) la risposta è 422 nel formato standard di FastAPI.",
        "operationId": "get_courses_v1_organizations__org_id__courses_get",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Identificativo di un'organizzazione associata alla chiave API.",
              "title": "Org Id"
            },
            "description": "Identificativo di un'organizzazione associata alla chiave API."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Numero massimo di corsi (1-100).",
              "default": 50,
              "title": "Limit"
            },
            "description": "Numero massimo di corsi (1-100)."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Corsi da saltare (paginazione).",
              "default": 0,
              "title": "Offset"
            },
            "description": "Corsi da saltare (paginazione)."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtra per stato esatto (es. `published`); uno stato sconosciuto dà una lista vuota.",
              "title": "Status"
            },
            "description": "Filtra per stato esatto (es. `published`); uno stato sconosciuto dà una lista vuota."
          },
          {
            "name": "updated_since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Data ISO 8601 **con fuso orario** (es. `2026-01-01T00:00:00Z`; un `+` va codificato come `%2B`). Senza fuso: 422.",
              "title": "Updated Since"
            },
            "description": "Data ISO 8601 **con fuso orario** (es. `2026-01-01T00:00:00Z`; un `+` va codificato come `%2B`). Senza fuso: 422."
          }
        ],
