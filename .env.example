# Configurazione di a4u-lms-api. Copiare in .env (non versionato) e compilare.
# Il file lo legge docker compose (env_file), non l'applicazione.

# Obbligatoria. Ruolo di sola lettura a4u_lms_ro sul Postgres di a4u (rete a4u_default).
# Accetta postgresql://, postgres:// o postgresql+asyncpg://
DATABASE_URL=postgresql://a4u_lms_ro:<password>@postgres:5432/<POSTGRES_DB>

# Obbligatoria. Base pubblica dei file su OVH (lo "/" finale viene tolto).
OVH_PUBLIC_BASE_URL=https://progettiersaf.com/media

# Richieste al minuto per API key (>= 1).
RATE_LIMIT_PER_MIN=120

# Durata della cache dell'autenticazione in secondi (0 = disattivata).
# Una revoca della key ha effetto entro questo tempo.
AUTH_CACHE_SECONDS=30

# Timeout delle query in millisecondi (>= 100).
DB_STATEMENT_TIMEOUT_MS=10000

# Pool di connessioni al DB.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=4

# Abilita /docs, /redoc e /openapi.json.
DOCS_ENABLED=false

# DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
